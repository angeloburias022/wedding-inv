# Copy to .env.local for local development. Set the same values in Vercel.

# Google Apps Script web app URL that appends RSVPs to the Google Sheet.
# Leave empty in development to log RSVPs to the terminal instead.
RSVP_WEBHOOK_URL=

# Shared secret sent with every RSVP; the Apps Script rejects requests without it.
RSVP_WEBHOOK_SECRET=

# Origin encoded into the printed QR codes. Must never change after printing.
PUBLIC_INVITATION_ORIGIN=https://angeloandgichelle.com

# YouTube Data API key, for the livestream's "Live now" badge. Without it the badge follows the clock.
# Restrict it to the YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=
